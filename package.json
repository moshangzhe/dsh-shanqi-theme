{
  "name": "dsh-shanqi-theme",
  "version": "0.1.9",
  "description": "「山栖」田园主题：把 DeepSeek Harness 接入真实的山湖昼夜与农人任务联动。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moshangzhe/dsh-shanqi-theme.git"
  },
  "homepage": "https://github.com/moshangzhe/dsh-shanqi-theme#readme",
  "bugs": {
    "url": "https://github.com/moshangzhe/dsh-shanqi-theme/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "screenshots.json",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "docs/*.md",
    "docs/screenshots/*.png",
    "docs/preview.html"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "theme",
    "plugin",
    "riverside",
    "shanqi"
  ],
  "dsh": {
    "engines": {
      "dsh": "0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "preview": "node scripts/build.mjs",
    "pack:local": "pnpm pack",
    "prepack": "node scripts/build.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1",
    "esbuild": "0.25.11",
    "jsdom": "26.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.7.3"
  }
}
